{
	"schemaVersion": 1,
	"id": "retroreplay",
	"version": "${version}",
	"name": "RetroReplay",
	"description": "Replay recording, camera paths and video rendering for old Minecraft versions.",
	"authors": [
		"Andrix03"
	],
	"license": "GPL-3.0-or-later",
	"icon": "assets/retroreplay/icon.png",
	"environment": "*",
	"entrypoints": {
		"init": [
			"io.github.andrix03.retroreplay.RetroReplay"
		]
	},
	"mixins": [
		"retroreplay.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "${minecraft_version}",
		"osl-entrypoints": ">=0.4.0"
	}
}
